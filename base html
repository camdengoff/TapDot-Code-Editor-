        };

        function getPageMeta(url) {
            for (const [key, val] of Object.entries(pageTitles)) {
                if (url.includes(key)) return val;
            }
            try {
                return { title: new URL(url).hostname.replace('www.', ''), icon: '🔗' };
            } catch {
                return { title: url, icon: '🔗' };
            }
        }

        // ── PAGE MODAL ───────────────────────────────────────────────────────
        function openPage(url) {
            const frame = document.getElementById('pageModalFrame');
            const loader = document.getElementById('pageModalLoader');
            const sheet = document.getElementById('pageModalSheet');
            const backdrop = document.getElementById('pageModalBackdrop');
            const meta = getPageMeta(url);
            document.getElementById('pageModalTitle').textContent = meta.title;
            document.getElementById('pageModalIcon').textContent = meta.icon;
            try {
                document.getElementById('pageModalUrl').textContent = new URL(url).hostname.replace('www.', '');
            } catch {
                document.getElementById('pageModalUrl').textContent = url;
            }
            loader.style.display = 'block';
            backdrop.classList.add('open');
            sheet.classList.add('open');
            document.getElementById('scroll-root').style.overflow = 'hidden';
            frame.onload = () => { loader.style.display = 'none'; };
            frame.src = url;
        }

        function closePage() {
            const frame = document.getElementById('pageModalFrame');
            const sheet = document.getElementById('pageModalSheet');
            const backdrop = document.getElementById('pageModalBackdrop');
            sheet.classList.remove('open');
            backdrop.classList.remove('open');
            document.getElementById('scroll-root').style.overflow = 'scroll';
            setTimeout(() => { frame.src = 'about:blank'; }, 400);
        }

        // ── NEXT STEPS MODAL ─────────────────────────────────────────────────
        function openNextSteps() {
            document.getElementById('nextStepsBackdrop').classList.add('open');
            document.getElementById('nextStepsSheet').classList.add('open');
            document.getElementById('scroll-root').style.overflow = 'hidden';
        }

        function closeNextSteps() {
            document.getElementById('nextStepsBackdrop').classList.remove('open');
            document.getElementById('nextStepsSheet').classList.remove('open');
            document.getElementById('scroll-root').style.overflow = 'scroll';
        }

        // ── EVENT DETAIL MODAL ───────────────────────────────────────────────
        function openEventDetail(ev) {
            document.getElementById('eventDetailTitle').textContent = ev.title;
            const opts = { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/Chicago' };
            const timeOpts = { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'America/Chicago' };
            let dateStr = ev.date ? ev.date.toLocaleString('en-US', opts) : '';
            if (ev.date) dateStr += ' · ' + ev.date.toLocaleString('en-US', timeOpts);
            document.getElementById('eventDetailDate').textContent = dateStr;
            const bodyEl = document.getElementById('eventDetailBody');
            bodyEl.innerHTML = '';
            if (ev.assetUrl) {
                const img = document.createElement('img');
                img.src = ev.assetUrl + '?format=1000w';
                img.style.cssText = 'width:100%;border-radius:12px;margin-bottom:16px;display:block;';
                bodyEl.appendChild(img);
            }
            if (ev.body) {
                const wrapper = document.createElement('div');
                wrapper.style.cssText = 'color:#fff;font-size:14px;line-height:1.6;';
                const parser = new DOMParser();
                const doc = parser.parseFromString(ev.body, 'text/html');
                doc.querySelectorAll('p, li, h1, h2, h3').forEach(node => {
                    const p = document.createElement('p');
                    p.style.cssText = 'margin-bottom:10px;color:#ccc;';
                    p.innerHTML = node.innerHTML;
                    wrapper.appendChild(p);
                });
                const buttons = doc.querySelectorAll('a.sqs-block-button-element');
                if (buttons.length) {
                    const btnRow = document.createElement('div');
                    btnRow.style.cssText = 'margin-top:20px;display:flex;flex-direction:column;gap:10px;';
                    buttons.forEach(btn => {
                        const a = document.createElement('a');
                        a.href = btn.href;
                        a.target = '_blank';
                        a.textContent = btn.textContent.trim();
                        a.style.cssText = 'display:block;background:var(--blue);color:#fff;text-align:center;padding:14px;border-radius:10px;font-weight:700;font-size:15px;text-decoration:none;';
                        a.onclick = (e) => { e.preventDefault(); window.open(btn.href, '_blank'); };
                        btnRow.appendChild(a);
                    });
                    wrapper.appendChild(btnRow);
                }
                bodyEl.appendChild(wrapper);
            }
            document.getElementById('eventDetailBackdrop').classList.add('open');
            document.getElementById('eventDetailSheet').classList.add('open');
            document.getElementById('scroll-root').style.overflow = 'hidden';
        }

        function closeEventDetail() {
            document.getElementById('eventDetailBackdrop').classList.remove('open');
            document.getElementById('eventDetailSheet').classList.remove('open');
            document.getElementById('scroll-root').style.overflow = 'scroll';
        }

        // ── RECURRENCE HELPERS ───────────────────────────────────────────────
        function detectIntervalDays(bodyHtml) {
            if (!bodyHtml) return null;
            const text = bodyHtml.replace(/<[^>]+>/g, ' ').toLowerCase();
            if (/every other week|bi-?weekly|biweekly/.test(text)) return 14;
            if (/every week|weekly|each week|every sunday|every monday|every tuesday|every wednesday|every thursday|every friday|every saturday/.test(text)) return 7;
            return null;
        }

        function getNextOccurrence(startDate, endDate, intervalDays) {
            const startCT = new Date(startDate.toLocaleString('en-US', { timeZone: 'America/Chicago' }));
            const hours   = startCT.getHours();
            const minutes = startCT.getMinutes();
            const todayStr = new Date().toLocaleDateString('en-US', { timeZone: 'America/Chicago' });
            const today = new Date(todayStr + ' 00:00:00');
            let cursor = new Date(startDate);
            while (cursor <= endDate) {
                const cursorCT = new Date(cursor.toLocaleString('en-US', { timeZone: 'America/Chicago' }));
                cursorCT.setHours(hours, minutes, 0, 0);
                if (cursorCT >= today) return cursorCT;
                cursor = new Date(cursor.getTime() + intervalDays * 86400000);
            }
            return null;
        }

        // ── EVENTS LOADING ───────────────────────────────────────────────────
        const MAX_EVENTS = 3;
        const JSON_URL = 'https://www.bethanynaz.org/upcoming-source-page?format=json';

        async function loadEvents() {
            const container = document.getElementById('events-container');
            try {
                let data = null;

                // Try direct fetch first (works when page is same-site)
                try {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 7000);
                    const res = await fetch(JSON_URL, { signal: controller.signal });
                    clearTimeout(timeoutId);
                    if (res.ok) data = await res.json();
                } catch (e) { /* fall through to proxies */ }

                // Proxy fallbacks
                if (!data) {
                    const proxies = [
                        `https://api.allorigins.win/get?url=${encodeURIComponent(JSON_URL)}`,
                        `https://corsproxy.io/?${encodeURIComponent(JSON_URL)}`,
                        `https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(JSON_URL)}`,
                        `https://thingproxy.freeboard.io/fetch/${JSON_URL}`,
                        `https://yacdn.org/proxy/${JSON_URL}`
                    ];
                    for (const proxyUrl of proxies) {
                        try {
                            const controller = new AbortController();
                            const timeoutId = setTimeout(() => controller.abort(), 7000);
                            const res = await fetch(proxyUrl, { signal: controller.signal });
                            clearTimeout(timeoutId);
                            if (res.ok) {
                                const json = await res.json();
                                data = json.contents ? JSON.parse(json.contents) : json;
                                if (data && (data.upcoming || data.items)) break;
                                data = null;
                            }
                        } catch (e) { continue; }
                    }
                }
                if (!data) throw new Error('All proxies failed');
                const items = data.upcoming || [];
                if (items.length === 0) throw new Error('No upcoming events');

                const tz = 'America/Chicago';
                const events = [];

                for (const item of items) {
                    const title = item.title || 'Event';
                    const startDate = new Date(item.startDate);
                    const endDate = item.endDate ? new Date(item.endDate) : null;
                    const isRecurring = endDate && (endDate - startDate) > 7 * 86400000;
                    let displayDate = startDate;

                    if (isRecurring) {
                        const intervalDays = detectIntervalDays(item.body || '') || 7;
                        const next = getNextOccurrence(startDate, endDate, intervalDays);
                        if (!next) continue;
                        displayDate = next;
                    } else {
                        const now = new Date();
                        const expiry = endDate || startDate;
                        if (expiry < now) continue;
                    }

                    const month = isNaN(displayDate) ? '' : displayDate.toLocaleString('en-US', { month: 'short', timeZone: tz });
                    const day   = isNaN(displayDate) ? '' : displayDate.toLocaleString('en-US', { day: 'numeric', timeZone: tz });
                    const meta  = isNaN(displayDate) ? '' : displayDate.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: tz });

                    events.push({ title, month, day, meta, date: displayDate, endDate, assetUrl: item.assetUrl, body: item.body });
                    if (events.length >= MAX_EVENTS) break;
                }

                if (events.length === 0) throw new Error('No current events');
                renderEvents(container, events);
            } catch (e) {
                console.error('[Events] Failed:', e);
                container.innerHTML = '<div class="events-loading">Could not load upcoming events.</div>';
            }
        }

        function renderEvents(container, events) {
            const list = document.createElement('div');
            list.className = 'events-list';
            events.forEach(ev => {
                const row = document.createElement('a');
                row.className = 'event-row';
                row.href = '#';
                row.onclick = (e) => { e.preventDefault(); openEventDetail(ev); };
                row.innerHTML = `
                    <div class="event-date">
                        <span class="event-mo">${ev.month}</span>
                        <span class="event-dy">${ev.day}</span>
                    </div>
                    <div class="event-detail">
                        <div class="event-name">${ev.title}</div>
                        <div class="event-meta">${ev.meta}</div>
                    </div>
                    <div class="event-chev">›</div>`;
                list.appendChild(row);
            });
            container.innerHTML = '';
            container.appendChild(list);
        }

        // ── CHAPEL TIME SWAP ───────────────────────────────────────────────
        // Tuesdays (2) and Thursdays (4), 10:00 AM – 11:30 AM Central Time
        // Swaps the banner AND starts the photo slideshow
        (function () {
            const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Chicago' }));
            const day = now.getDay();            // 0=Sun … 6=Sat
            const hours = now.getHours();
            const minutes = now.getMinutes();
            const time = hours * 60 + minutes;   // minutes since midnight

            const isTueOrThu = (day === 2 || day === 4);
            const isDuringChapel = (time >= 600 && time < 690); // 10:00–11:30

            // ⚠️ TEST OVERRIDE — set to true to force chapel mode, remove when done
            const testMode = false;

            const wrap = document.getElementById('heroSlideshow');

            if (testMode || (isTueOrThu && isDuringChapel)) {
                // ── Swap the banner ──
                const banner = document.querySelector('.notes-banner');
