<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>Bethany First Church</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        /* ── Squarespace default overrides ── */
        body {
            padding-top: 0 !important;
            margin-top: 0 !important;
        }
        /* ── Force flower background on Squarespace wrappers ── */
        html, body, #siteWrapper, #site, #page, .content-wrapper,
        .page-section, section, .Index-page-content,
        .sqs-block-code, article, main, footer, header {
            background: #191818 !important;
        }
        .sqs-block-content,
        .sqs-layout,
        .sqs-col-wm-12,
        .sqs-block {
            padding: 0 !important;
            margin: 0 !important;
        }
        /* Override Squarespace typography injection */
        .page .hero-body,
        .page .hero-title,
        .page .hero-sub,
        .page .notes-banner-text,
        .page .notes-banner-eyebrow,
        .page .notes-banner-title,
        .page .notes-banner-sub,
        .page .section-head,
        .page .section-head h2,
        .page .see-all,
        .page .quick-btn,
        .page .event-title,
        .page .event-time,
        .page .event-month,
        .page .event-day,
        .page .ministry-pill-tag,
        .page .ministry-pill-name,
        .page .view-all-btn,
        .page .events-loading {
            line-height: 1.3 !important;
            letter-spacing: 0 !important;
            word-spacing: 0 !important;
        }
        #scroll-root {
            top: 0 !important;
        }

        /* ── Hide site-wide search bar and header on this page ── */
        #sq-search-header-slot,
        #sq-mobile-search-btn,
        #sq-search-overlay { display: none !important; }

        :root {
            --bg: #000000;
            --card: #3D3D3D;
            --card2: #484848;
            --white: #ffffff;
            --muted: #999999;
            --blue: #3b7de1;
            --radius: 14px;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #191818;
            color: var(--white);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 15px;
            line-height: 1.5;
            -webkit-text-size-adjust: 100%;
        }

        #scroll-root {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            overflow-y: scroll;
            -webkit-overflow-scrolling: touch;
            overscroll-behavior: none;
        }

        .page {
            max-width: 100%;
            margin: 0;
            padding-top: 20px;
            padding-bottom: 24px;
            background: transparent;
        }

        @media (min-width: 481px) {
            body {
                background: #191818;
            }

            .page {
                max-width: 480px;
                margin: 0 auto;
                box-shadow: none;
            }
        }

        .hero-card {
            margin: 12px 14px 0;
            border-radius: var(--radius);
            overflow: hidden;
            background: var(--card);
        }

        .hero-img-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 16/9;
            overflow: hidden;
            background: #222;
        }

        .hero-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            opacity: 0;
            transition: opacity 1s ease;
        }

        .hero-img.active {
            opacity: 1;
        }

        .hero-body {
            padding: 18px 20px 24px;
        }

        .hero-title {
            font-size: 23px;
            font-weight: 800;
            line-height: 1.15;
            margin-bottom: 4px;
        }

        .hero-title .blue {
            color: var(--blue);
        }

        .hero-title .white {
            color: var(--white);
        }

        .hero-sub {
            font-size: 14px;
            color: var(--muted);
        }

        .quick-row {
            display: flex;
            gap: 10px;
            padding: 14px 14px 0;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        .quick-row::-webkit-scrollbar {
            display: none;
        }

        .quick-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 11px 16px;
            background: var(--card);
            border-radius: 50px;
            color: var(--white);
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            flex-shrink: 0;
            -webkit-tap-highlight-color: transparent;
            cursor: pointer;
            border: none;
            text-decoration: none;
        }

        .quick-btn:active {
            background: var(--card2);
        }

        .quick-icon {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        .ic-prayer {
            background: rgba(251, 191, 36, 0.15);
        }

        .ic-steps {
            background: rgba(59, 125, 225, 0.2);
        }

        .ic-serve {
            background: rgba(16, 185, 129, 0.15);
        }

        .section-head {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            padding: 15px 14px 3px !important;
            margin: 0 !important;
            min-height: 0 !important;
        }

        .section-head h2 {
            font-size: 18px !important;
            font-weight: 700 !important;
            line-height: 1.2 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .see-all {
            font-size: 13px !important;
            color: var(--muted);
            text-decoration: none;
            -webkit-tap-highlight-color: transparent;
            cursor: pointer;
            border: none;
            background: none;
            margin: 0 !important;
            padding: 0 !important;
            line-height: 1.2 !important;
        }

        .see-all:active {
            color: var(--white);
        }

        .notes-banner-wrap {
            margin: 6px 14px 0;
        }

        .notes-banner {
            display: flex;
            align-items: center;
            gap: 14px;
            background: var(--card);
            border-radius: var(--radius);
            padding: 16px;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
            border: none;
            width: 100%;
            color: var(--white);
            text-decoration: none;
        }

        .notes-banner:active {
            background: var(--card2);
        }

        .notes-banner-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(59, 125, 225, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .notes-banner-text {
            flex: 1;
            min-width: 0;
        }

        .notes-banner-eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--blue);
            margin-bottom: 3px;
        }

        .notes-banner-title {
            font-size: 15px;
            font-weight: 700;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .notes-banner-sub {
            font-size: 12px;
            color: var(--muted);
            margin-top: 2px;
        }

        .notes-banner-arrow {
            color: var(--muted);
            font-size: 22px;
            flex-shrink: 0;
        }

        .ministry-scroll {
            display: flex;
            gap: 10px;
            padding: 0 14px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        .ministry-scroll::-webkit-scrollbar {
            display: none;
        }

        .ministry-pill {
            display: flex;
            align-items: center;
            background: var(--card);
            border-radius: var(--radius);
            overflow: hidden;
            color: var(--white);
            flex-shrink: 0;
            width: 195px;
            -webkit-tap-highlight-color: transparent;
            cursor: pointer;
            border: none;
            text-decoration: none;
        }

        .ministry-pill:active {
            background: var(--card2);
        }

        .ministry-pill img {
            width: 64px;
            height: 64px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .ministry-pill-info {
            padding: 0 12px;
            min-width: 0;
        }

        .ministry-pill-tag {
            font-size: 10px;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.07em;
            margin-bottom: 2px;
        }

        .ministry-pill-name {
            font-size: 14px;
            font-weight: 700;
            line-height: 1.2;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .events-list {
            display: flex;
            flex-direction: column;
            gap: 1px;
            margin: 0 14px;
            background: rgba(0, 0, 0, 0.4);
            border-radius: var(--radius);
            overflow: hidden;
        }

        .event-row {
            display: flex;
            align-items: center;
            gap: 14px;
            background: var(--card);
            padding: 14px 16px;
            color: var(--white);
            -webkit-tap-highlight-color: transparent;
            cursor: pointer;
            border: none;
            width: 100%;
            text-align: left;
            text-decoration: none;
        }

        .event-row:active {
            background: var(--card2);
        }

        .event-date {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 36px;
        }

        .event-mo {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--blue);
            letter-spacing: 0.05em;
        }

        .event-dy {
            font-size: 24px;
            font-weight: 800;
            line-height: 1;
        }

        .event-detail {
            flex: 1;
            min-width: 0;
        }

        .event-name {
            font-size: 14px;
            font-weight: 600;
            line-height: 1.3;
            margin-bottom: 2px;
        }

        .event-meta {
            font-size: 12px;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .event-chev {
            color: var(--muted);
            font-size: 18px;
            flex-shrink: 0;
        }

        .events-loading {
            margin: 0 14px;
            padding: 20px;
            background: var(--card);
            border-radius: var(--radius);
            text-align: center;
            color: var(--muted);
            font-size: 13px;
        }

        .view-all-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 6px 14px 0;
            padding: 14px;
            background: var(--card);
            border-radius: var(--radius);
            font-size: 14px;
            font-weight: 600;
            color: var(--white);
            -webkit-tap-highlight-color: transparent;
            cursor: pointer;
            border: none;
            width: calc(100% - 28px);
            text-decoration: none;
        }

        .view-all-btn:active {
            background: var(--card2);
        }

        /* PAGE MODAL */
        .page-modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 200;
            backdrop-filter: blur(4px);
        }

        .page-modal-backdrop.open {
            display: block;
        }

        .page-modal-sheet {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 201;
            background: #1a1a1a;
            border-radius: 20px 20px 0 0;
            height: 85vh;
            overflow: hidden;
            transform: translateY(100%);
            transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
            max-width: 480px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
        }

        .page-modal-sheet.open {
            transform: translateY(0);
        }

        .page-modal-handle-bar {
            display: flex;
            justify-content: center;
            padding: 8px 0 4px;
            flex-shrink: 0;
        }

        .page-modal-handle-bar span {
            width: 36px;
            height: 4px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 99px;
        }

        .page-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0px 16px 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.07);
            flex-shrink: 0;
        }

        .page-modal-header-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .page-modal-header-icon {
            font-size: 20px;
            line-height: 1;
        }

        .page-modal-header-text h2 {
            font-size: 15px;
            font-weight: 700;
            color: var(--white);
        }

        .page-modal-header-text p {
            font-size: 11px;
            color: var(--blue);
            margin-top: 0px;
        }

        .page-modal-close {
            width: 30px;
            height: 30px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            border: none;
            color: var(--white);
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
        }

        .page-modal-close:active {
            background: rgba(255, 255, 255, 0.2);
        }

        .page-modal-body {
            flex: 1;
            overflow: hidden;
            position: relative;
        }

        .page-modal-iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
        }

        .page-modal-loader {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--blue), #60a5fa);
            transform-origin: left;
            animation: loadBar 1.6s ease-in-out infinite;
            z-index: 302;
            border-radius: 0 2px 2px 0;
        }

        @keyframes loadBar {
            0% {
                transform: scaleX(0);
                opacity: 1;
            }

            70% {
                transform: scaleX(0.85);
                opacity: 1;
            }

            100% {
                transform: scaleX(1);
                opacity: 0;
            }
        }

        /* MODAL */
        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 200;
            backdrop-filter: blur(4px);
        }

        .modal-backdrop.open {
            display: block;
        }

        .modal-sheet {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 201;
            background: #1a1a1a;
            border-radius: 20px 20px 0 0;
            max-height: 92vh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            transform: translateY(100%);
            transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
            max-width: 480px;
            margin: 0 auto;
        }

        .modal-sheet.open {
            transform: translateY(0);
        }

        .modal-handle-bar {
            display: flex;
            justify-content: center;
            padding: 12px 0 4px;
        }

        .modal-handle-bar span {
            width: 36px;
            height: 4px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 99px;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 4px 20px 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        }

        .modal-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .modal-header-icon {
            font-size: 24px;
            line-height: 1;
        }

        .modal-header-text h2 {
            font-size: 17px;
            font-weight: 700;
        }

        .modal-header-text p {
            font-size: 12px;
            color: var(--muted);
            margin-top: 1px;
        }

        .modal-close {
            width: 30px;
            height: 30px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            border: none;
            color: var(--white);
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
        }

        .modal-close:active {
            background: rgba(255, 255, 255, 0.2);
        }

        .modal-body {
            padding: 20px 20px 40px;
        }

        .nextsteps-item {
            display: flex;
            align-items: center;
            gap: 16px;
            background: var(--card);
            border-radius: var(--radius);
            padding: 18px 16px;
            margin-bottom: 10px;
            width: 100%;
            border: none;
            color: var(--white);
            text-align: left;
            cursor: pointer;
            text-decoration: none;
        }

        .nextsteps-item:active {
            background: var(--card2);
        }

        .nextsteps-item:last-child {
            margin-bottom: 0;
        }

        .nextsteps-item-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .ns-ic-1 {
            background: rgba(59, 125, 225, 0.2);
        }

        .ns-ic-2 {
            background: rgba(16, 185, 129, 0.2);
        }

        .ns-ic-3 {
            background: rgba(251, 191, 36, 0.2);
        }

        .ns-ic-4 {
            background: rgba(16, 185, 129, 0.2);
        }

        .nextsteps-item-text {
            flex: 1;
            min-width: 0;
        }

        .nextsteps-item-title {
            font-size: 16px;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 3px;
        }

        .nextsteps-item-desc {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.4;
        }

        .nextsteps-item-arrow {
            color: var(--muted);
            font-size: 20px;
            flex-shrink: 0;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(28px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .anim {
            opacity: 0;
            animation: slideUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .anim-1 { animation-delay: 0.05s; }
        .anim-2 { animation-delay: 0.12s; }
        .anim-3 { animation-delay: 0.19s; }
        .anim-4 { animation-delay: 0.26s; }
        .anim-5 { animation-delay: 0.33s; }
        .anim-6 { animation-delay: 0.40s; }
        .anim-7 { animation-delay: 0.47s; }

        @media (prefers-reduced-motion: reduce) {
            .anim {
                animation: none;
                opacity: 1;
            }
        }
    </style>
</head>

<body>
    <div id="scroll-root">
        <div class="page">

            <div class="hero-card anim anim-1">
                <div class="hero-img-wrap" id="heroSlideshow"></div>
                <div class="hero-body">
                    <div class="hero-title">
                        <span class="blue">Bethany First</span> <span class="white">Church</span>
                    </div>
                    <div class="hero-sub">We're glad you're here.</div>
                </div>
            </div>

            <div class="quick-row anim anim-2">
                <a href="#" class="quick-btn" onclick="openPage('https://bethanynaz-proxy.cgoff.workers.dev/prayer'); return false;">
                    <span class="quick-icon ic-prayer">🙏</span>Ask for Prayer
                </a>
                <a href="#" class="quick-btn" onclick="openNextSteps(); return false;">
                    <span class="quick-icon ic-steps">✚</span>Next Steps
                </a>
                <a href="#" class="quick-btn" onclick="openPage('https://bethanynaz.org/give'); return false;">
                    <span class="quick-icon ic-serve">💵</span>Give
                </a>
            </div>

            <div class="notes-banner-wrap anim anim-2">
                <a href="#" class="notes-banner" onclick="window.location.href='http://bethanynaz.info/connect'; return false;">
                    <div class="notes-banner-icon">👋</div>
                    <div class="notes-banner-text">
                        <div class="notes-banner-eyebrow">New Here?</div>
                        <div class="notes-banner-title">Connect with Us</div>
                        <div class="notes-banner-sub">Share your name with us and let us know you visited!</div>
                    </div>
                    <div class="notes-banner-arrow">›</div>
                </a>
            </div>

            <div class="notes-banner-wrap anim anim-2">
                <a href="#" class="notes-banner" onclick="window.location.href='https://www.bethanynaz.org/construction'; return false;">
                    <div class="notes-banner-icon">🚧</div>
                    <div class="notes-banner-text">
                        <div class="notes-banner-eyebrow" style="color:var(--blue);">Campus Renewal</div>
                        <div class="notes-banner-title">Construction In Progress</div>
                        <div class="notes-banner-sub">Learn more about what to expect.</div>
                    </div>
                    <div class="notes-banner-arrow">›</div>
                </a>
            </div>

            <div class="notes-banner-wrap anim anim-2">
                <a href="#" class="notes-banner" onclick="window.location.href='https://tsiems.wufoo.com/forms/m4s4eo50gl8kmd/'; return false;">
                    <div class="notes-banner-icon" style="background:rgba(59,125,225,0.2);">🤝</div>
                    <div class="notes-banner-text">
                        <div class="notes-banner-title">Becoming Course Sign-Up</div>
                        <div class="notes-banner-sub">Take the next step in becoming part of the BFC community.</div>
                    </div>
                    <div class="notes-banner-arrow">›</div>
                </a>
            </div>

            <div class="section-head anim anim-5">
                <h2>Upcoming Events</h2>
                <a href="#" class="see-all" onclick="openPage('https://bethanynaz-proxy.cgoff.workers.dev/events'); return false;">See All</a>
            </div>
            <div id="events-container" class="anim anim-6">
                <div class="events-loading">Loading events…</div>
            </div>
            <a href="#" class="view-all-btn anim anim-7" onclick="openPage('https://bethanynaz-proxy.cgoff.workers.dev/events'); return false;">View All Events</a>

            <div class="section-head anim anim-4">
                <h2>Ministries</h2>
                <a href="#" class="see-all" onclick="openPage('https://bethanynaz-proxy.cgoff.workers.dev/ministries-menu'); return false;">See All</a>
            </div>
